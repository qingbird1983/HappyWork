# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# Markdown 行尾双空格是换行语法，不裁剪
trim_trailing_whitespace = false

[*.{py,java,rs,go,kt}]
indent_size = 4

[Makefile]
indent_style = tab
